# Copia este archivo como .env y ajusta los valores. Nunca subas .env (está en .gitignore).
# Todo lo que empieza por VITE_ es PÚBLICO (llega al navegador): no pongas claves aquí.

# true = datos simulados (services/mocks); false = APIs reales (NASA POWER). Por defecto: false
VITE_USE_MOCKS=false

# URL del backend/proxy propio (asistente IA, APIs con credenciales)
VITE_API_BASE_URL=

# ─── Asistente IA (server/index.js) ───────────────────────────────────────────
# Estas variables las lee SOLO el servidor (no llevan VITE_: nunca llegan al navegador).
# Sin key, el servidor responde en MODO DEMO (respuestas de prueba).

# Proveedor: google | groq | openai
AI_PROVIDER=google

# Modelo. Si lo dejas vacío se usa el valor por defecto del proveedor.
AI_MODEL=gemini-3.5-flash-lite

# Key de Gemini: https://aistudio.google.com → Get API key
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Tiempo máximo de espera al modelo, en milisegundos. Opcional.
# AI_TIMEOUT_MS=30000

PORT=3001
